{
  "manifest_version": 3,
  "name": "AppFiller",
  "version": "0.1.0",
  "description": "Teach-once auto-fill for job application fields (EEO/diversity + custom data).",
  "permissions": ["storage", "activeTab"],
  "action": { "default_popup": "src/popup.html", "default_title": "AppFiller" },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content-loader.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["src/content.js", "src/lib/*.js"], "matches": ["<all_urls>"] }
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
